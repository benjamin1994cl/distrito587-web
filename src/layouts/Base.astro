---
import type { ComponentProps } from 'astro/types';
import '../styles/global.css';
import { url, urlAbsoluta } from '../lib/formato';
import { datos } from '../lib/local';
import BarraAtajos from '../components/BarraAtajos.astro';
import Navbar from '../components/Navbar.astro';
import bebas from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import barlow600 from '@fontsource/barlow/files/barlow-latin-600-normal.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta interna para el canonical, por ejemplo "carta". */
  ruta?: string;
  jsonLd?: Record<string, unknown>;
  noIndexar?: boolean;
  /** Atajos de la barra inferior (solo celular). Sin ellos no se monta la barra. */
  atajos?: ComponentProps<typeof BarraAtajos>['atajos'];
}

const { titulo, descripcion, ruta = '', jsonLd, noIndexar = false, atajos } = Astro.props;
const canonical = urlAbsoluta(ruta);
// La portada (ruta vacía) tiene hero y secciones; /carta usa la barra como cabecera; el resto, barra simple.
const variante = ruta === '' ? 'portada' : ruta === 'carta' ? 'carta' : 'simple';
const tocomples = atajos?.some((a) => a.href === '#t-tocomples') ?? false;
const imagenOg = urlAbsoluta('og-distrito587.png');
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!noIndexar && <link rel="canonical" href={canonical} />}
    {noIndexar && <meta name="robots" content="noindex" />}

    <link rel="preload" href={bebas} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow600} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={datos.nombre} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {!noIndexar && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Distrito 587, Smash & Fries" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Navbar variante={variante} tocomples={tocomples} />
    <slot />
    {atajos && atajos.length > 0 && <BarraAtajos atajos={atajos} />}
  </body>
</html>
