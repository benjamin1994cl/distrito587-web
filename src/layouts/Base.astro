---
import '../styles/global.css';
import { url, urlAbsoluta } from '../lib/formato';
import { datos } from '../lib/local';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta interna para el canonical, por ejemplo "carta". */
  ruta?: string;
  jsonLd?: Record<string, unknown>;
  noIndexar?: boolean;
}

const { titulo, descripcion, ruta = '', jsonLd, noIndexar = false } = Astro.props;
const canonical = urlAbsoluta(ruta);
const imagenOg = urlAbsoluta('og-distrito587.png');
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noIndexar && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={datos.nombre} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Distrito 587, Smash & Fries" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
