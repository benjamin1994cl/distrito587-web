---
// Carta liviana para los QR de las mesas. Una columna, pestañas con anclas
// (funcionan sin JS) y un script opcional que marca la pestaña activa.
import Base from '../layouts/Base.astro';
import carta from '../data/carta.json';
import { precio, url } from '../lib/formato';
import Credito from '../components/Credito.astro';
import MiniaturaProducto from '../components/MiniaturaProducto.astro';
import EnlacesPedido from '../components/EnlacesPedido.astro';
import DialogoFoto from '../components/DialogoFoto.astro';
import { tieneFoto } from '../lib/fotos-carta';
import { datos, direccionCorta } from '../lib/local';
import { jsonLdMenu } from '../lib/carta-ld';

const burgers = carta.categorias.find((c) => c.id === 'hamburguesas');
const desde = burgers ? Math.min(...burgers.productos.map((b) => b.precio)) : 0;
---

<Base
  titulo="Carta de smash burgers en Osorno | Distrito 587"
  descripcion={`Carta de Distrito 587, hamburguesería en Osorno: smash burgers desde ${precio(desde)} con papas caseras de regalo, tocomples, agregados y bebidas.`}
  ruta="carta"
  jsonLd={jsonLdMenu()}
>
  <main id="contenido">
    <!-- La navbar (Base) hace de cabecera: logo a inicio. Aquí queda solo el título. -->
    <div class="cabecera">
      <h1>Carta</h1>
    </div>

    <nav class="pestanas" aria-label="Categorías de la carta">
      <ul>
        {
          carta.categorias.map((c) => (
            <li>
              <a href={`#${c.id}`}>{c.nombre}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="carta">
      <p class="aviso">Todas las burgers llevan papas caseras de regalo</p>
      {
        carta.categorias.map((c) => (
          <section id={c.id} class="categoria" aria-labelledby={`t-${c.id}`}>
            <h2 id={`t-${c.id}`}>{c.nombre}</h2>
            <ul>
              {c.productos.map((p) => (
                <li class="producto">
                  <MiniaturaProducto
                    imagen={p.imagen}
                    nombre={p.nombre}
                    precio={p.precio}
                    reservar={c.productos.some(tieneFoto)}
                  />
                  <div class="producto__cuerpo">
                    <div class="producto__fila">
                      <h3>{p.nombre}</h3>
                      <p class="precio">{precio(p.precio)}</p>
                    </div>
                    {p.descripcion && <p class="producto__desc">{p.descripcion}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>

  {
    datos.delivery.some((d) => d.url) && (
      <aside class="en-casa" aria-labelledby="t-en-casa">
        <EnlacesPedido modo="corto" rotulo="¿Lo quieres en casa?" idRotulo="t-en-casa" incluir={['ubereats', 'pedidosya']} />
      </aside>
    )
  }

  <DialogoFoto />

  <footer class="pie-carta">
    <p>{direccionCorta}</p>
    <EnlacesPedido incluir={['instagram']} />
    <p><a href={url()}>Ir al inicio</a></p>
    <Credito />
  </footer>
</Base>

<script>
  // Opcional: marca la pestaña de la categoría visible. Sin JS las anclas igual funcionan.
  const lista = document.querySelector<HTMLElement>('.pestanas ul')!;
  const enlaces = new Map(
    [...lista.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.hash.slice(1), a]),
  );
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');

  // Degradado solo en el lado donde quedan pestañas ocultas
  const bordes = () => {
    const max = lista.scrollWidth - lista.clientWidth;
    lista.toggleAttribute('data-mas-izq', lista.scrollLeft > 1);
    lista.toggleAttribute('data-mas-der', lista.scrollLeft < max - 1);
  };

  // Centra la pestaña activa moviendo solo la fila, nunca la página. Se mide con
  // getBoundingClientRect: offsetLeft va relativo al contenedor sticky, no a la lista.
  const centrar = (a: HTMLElement) => {
    const r = a.getBoundingClientRect();
    const l = lista.getBoundingClientRect();
    const destino = lista.scrollLeft + (r.left - l.left) - (lista.clientWidth - r.width) / 2;
    lista.scrollTo({ left: Math.max(0, destino), behavior: reducido.matches ? 'auto' : 'smooth' });
  };

  const observador = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        enlaces.forEach((a) => a.removeAttribute('aria-current'));
        const activo = enlaces.get(e.target.id);
        if (activo) {
          activo.setAttribute('aria-current', 'true');
          centrar(activo);
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  document.querySelectorAll('.categoria').forEach((s) => observador.observe(s));

  lista.addEventListener('scroll', bordes, { passive: true });
  addEventListener('resize', bordes);
  bordes();
</script>

<style>
  /* Altura fija de las pestañas: el scroll-padding de los anclajes la suma a la navbar */
  :global(:root) {
    --alto-pestanas: 3.75rem;
  }

  :global(html:has(.pestanas)) {
    scroll-padding-top: calc(var(--alto-navbar) + var(--alto-pestanas) + 1rem);
  }

  .cabecera {
    max-width: 40rem;
    margin-inline: auto;
    padding: 0.75rem max(var(--gutter), env(safe-area-inset-right, 0px)) 0
      max(var(--gutter), env(safe-area-inset-left, 0px));
  }

  /* Altura fija: al cargar la fuente el título no mueve la lista */
  .cabecera h1 {
    height: 1.25em;
    line-height: 1.25;
    font-size: 2.6rem;
    color: var(--d587-rojo);
  }

  .pestanas {
    position: sticky;
    top: var(--alto-navbar);
    z-index: 5;
    height: var(--alto-pestanas);
    background: var(--fondo);
    border-bottom: 1px solid var(--borde);
  }

  /* La fila ocupa todo el ancho (el recorte coincide con el borde de la pantalla) y el
     relleno centra el contenido en la columna de 40rem. */
  .pestanas ul {
    --fade-izq: 0px;
    --fade-der: 0px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    margin: 0;
    padding: 0
      max(var(--gutter), env(safe-area-inset-right, 0px), calc((100% - 40rem) / 2 + var(--gutter)))
      0
      max(var(--gutter), env(safe-area-inset-left, 0px), calc((100% - 40rem) / 2 + var(--gutter)));
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-izq),
      #000 calc(100% - var(--fade-der)),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-izq),
      #000 calc(100% - var(--fade-der)),
      transparent
    );
  }

  .pestanas ul[data-mas-izq] {
    --fade-izq: 2rem;
  }

  .pestanas ul[data-mas-der] {
    --fade-der: 2rem;
  }

  .pestanas li {
    flex: none;
  }

  .pestanas a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--borde);
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .pestanas a:focus-visible {
    outline: 3px solid var(--d587-amarillo);
    outline-offset: 2px;
  }

  .pestanas a[aria-current] {
    background: var(--d587-amarillo);
    border-color: var(--d587-amarillo);
    color: #000;
  }

  .carta,
  .pie-carta {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px))
      max(var(--gutter), env(safe-area-inset-right, 0px));
  }

  .aviso {
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--d587-amarillo);
    color: #000;
    border-radius: var(--radio);
    font-family: var(--display);
    font-size: 1.5rem;
    line-height: 1.1;
    text-align: center;
  }

  .categoria {
    padding-top: 2rem;
  }

  .categoria h2 {
    font-size: 2.6rem;
    color: var(--d587-naranja);
    margin-bottom: 0.25rem;
  }

  .categoria ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .producto {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--borde);
  }

  .producto__cuerpo {
    flex: 1;
    min-width: 0;
  }

  .producto__fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .producto h3 {
    font-family: var(--cuerpo);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .producto .precio {
    font-size: 2rem;
    line-height: 1;
  }

  .producto__desc {
    margin-top: 0.25rem;
    color: var(--texto-suave);
    font-size: 1rem;
  }

  .en-casa {
    max-width: 40rem;
    margin: 2rem auto 0;
    padding: 1rem max(var(--gutter), env(safe-area-inset-left, 0px));
    border-top: 1px solid var(--borde);
  }

  .pie-carta {
    padding-block: 2.5rem 3rem;
    color: var(--texto-suave);
    font-size: 0.95rem;
    display: grid;
    gap: 0.4rem;
  }
</style>
