---
// Foto opcional de un producto. Busca src/assets/carta/<imagen>.{avif,webp,jpg,jpeg,png}.
// Si no existe el archivo (hoy no hay fotos propias), no muestra nada.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagen: string | null;
  /** Se mantiene por compatibilidad: la foto es decorativa, el h3 ya nombra el producto. */
  alt?: string;
  ancho?: number;
}

const { imagen, ancho = 480 } = Astro.props;
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/carta/*.{avif,webp,jpg,jpeg,png}',
  { eager: true },
);
const encontrada = imagen
  ? Object.entries(archivos).find(([ruta]) => ruta.split('/').pop()!.replace(/\.\w+$/, '') === imagen)
  : undefined;
---

{
  encontrada && (
    <Picture
      src={encontrada[1].default}
      alt=""
      width={ancho}
      widths={[ancho / 2, ancho, ancho * 1.5].map(Math.round)}
      sizes={`(min-width: 48rem) ${ancho / 2}px, 100vw`}
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'foto-producto' }}
    />
  )
}
