---
import svgCrudo from '../assets/marca/distrito587-logo-armado.svg?raw';

// El texto del h1 va en un span oculto (legible para buscadores y lectores de pantalla);
// el SVG queda decorativo para que el nombre no se lea dos veces.
const svg = svgCrudo.replace(/\srole="img"\saria-label="[^"]*"/, ' aria-hidden="true" focusable="false"');

// Si el SVG cambia y el reemplazo ya no aplica, el h1 quedaría con el SVG anunciado dos veces: que el build falle
if (svg === svgCrudo) {
  throw new Error('LogoArmado: no se pudo reemplazar role/aria-label del SVG; revisa distrito587-logo-armado.svg');
}
---

<h1 class="hero__logo">
  <span class="visualmente-oculto">Distrito 587, smash burgers en Osorno</span>
  <Fragment set:html={svg} />
</h1>

<style is:global>
  .hero__logo {
    position: relative;
    width: min(100%, 35rem);
    margin-inline: auto;
  }

  .logo-armado {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pieza {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  /* Brillo: franja de luz recortada con la forma del logo */
  .hero__logo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    -webkit-mask: url('../assets/marca/distrito587-logo-color.svg') center / 100% 100% no-repeat;
    mask: url('../assets/marca/distrito587-logo-color.svg') center / 100% 100% no-repeat;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.95) 50%, transparent 65%) 150% 0 / 250% 100% no-repeat;
  }

  /* Fondos oscuros: lo gris del logo pasa a blanco (contraste) */
  .oscuro .pieza[fill='#575B5C'] {
    fill: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-armado {
      animation: colorear 1.1s ease-out 2.75s both;
    }

    .pieza {
      animation: caer 0.8s both;
    }

    .pan-abajo {
      animation-delay: 0s;
    }

    .banda {
      animation-delay: 0.3s;
    }

    .letra {
      animation-delay: calc(0.6s + var(--i) * 0.08s);
    }

    .queso {
      animation: derretir 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 1.55s both;
      transform-origin: 50% 0;
    }

    .pan-arriba {
      animation-delay: 1.85s;
      animation-duration: 0.9s;
    }

    .papas {
      animation-delay: 2.3s;
      animation-duration: 0.7s;
    }

    .hero__logo::after {
      animation: brillar 1s ease-in-out 2.9s both;
    }
  }

  /* Cae con rebote */
  @keyframes caer {
    0% {
      transform: translateY(-420px);
      opacity: 0;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    20% {
      opacity: 1;
    }
    55% {
      transform: translateY(0) scale(1.06, 0.9);
      animation-timing-function: cubic-bezier(0, 0.55, 0.45, 1);
    }
    72% {
      transform: translateY(-22px) scale(0.98, 1.03);
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    86% {
      transform: translateY(0) scale(1.02, 0.97);
    }
    93% {
      transform: translateY(-5px);
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes derretir {
    from {
      transform: scaleY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
  }

  /* Se arma en gris; al final brilla y toma color */
  @keyframes colorear {
    0% {
      filter: grayscale(1) brightness(1.05) drop-shadow(0 0 0 rgb(255 205 39 / 0));
    }
    45% {
      filter: grayscale(0) brightness(1.25) drop-shadow(0 0 22px rgb(255 205 39 / 0.85));
    }
    100% {
      filter: grayscale(0) brightness(1) drop-shadow(0 0 0 rgb(255 205 39 / 0));
    }
  }

  @keyframes brillar {
    0% {
      opacity: 1;
      background-position: 150% 0;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: -50% 0;
    }
  }
</style>
